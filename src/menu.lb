def init(module):
    module.name = ":menu"
    module.description = """\
# Communicating Menu Views

`xpcc::CommunicatingView` and `xpcc::CommunicatingViewStack` give the views of
the `modm:ui:menu` module access to an `xpcc::Communicator`.
"""

def prepare(module, options):
    module.depends(":communication", "modm:ui:menu")
    return True

def build(env):
    env.outbasepath = "xpcc/src/xpcc/ui"
    env.copy("xpcc/ui", ".")
