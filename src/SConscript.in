# Generated by the xpcc:communication module instead of the default repository
# SConscript of modm:build:scons, so that the XPCC generator can add sources.
from os.path import abspath
Import("env")

profile = ARGUMENTS.get("profile", "release")

%% for name, profiles in flags.items()
%% for profile, values in profiles.items() if values | length
%% if profile
if profile == "{{ profile }}":
    env.Append({{ name | upper }}=[{% for v in values %}{{ v | flags_format }}, {% endfor %}])
%% else
env.Append({{ name | upper }}=[{% for v in values %}{{ v | flags_format }}, {% endfor %}])
%% endif
%% endfor
%% endfor

env.AppendUnique(CPPPATH=[
%% for path in include_paths | sort
    abspath("{{ path | relocate }}"),
%% endfor
])

files = [
%% for file, flags in sources
%% if flags | length
    env.Object("{{ file | relocate }}", **{ {%- for key, profiles in flags.items() %}"{{ key | upper }}": ["${{ key | upper }}"] + {{ profiles[""] }}, {% endfor -%} }),
%% else
    env.File("{{ file | relocate }}"),
%% endif
%% endfor
]
%% if generator
{{ '' }}
# Generating the XPCC communication of the application
env.Append(toolpath=[abspath("scons/site_tools")])
env.Tool("xpcc_generator")
env.AppendUnique(CPPPATH=[abspath("generated")])
files += env.XpccCommunication(
    xmlfile=abspath("{{ generator.source }}"),
    container="{{ generator.container }}",
    path=abspath("generated"),
    namespace="{{ generator.namespace }}",
    include_paths=[abspath("{{ generator.project }}")])
%% endif

library = env.StaticLibrary(target="xpcc", source=files)
env.AppendUnique(LIBS=[library])
env.AppendUnique(LIBPATH=[abspath(str(library[0].get_dir()))])

Return("library")
