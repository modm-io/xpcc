def init(module):
    module.name = ":generator"
    module.description = """\
# XPCC Generator

Translates the XPCC XML declarations into C++ code during the build. The
generated sources are placed into `xpcc/generated`, compiled into the xpcc
library and available as top-level includes like `#include <identifier.hpp>`.

Only the SCons build script generator (`modm:build:scons`) is supported.
"""

def prepare(module, options):
    module.depends(":communication", "modm:build:scons")
    module.add_option(
        PathOption(name="source", default="", empty_ok=True, absolute=True,
                   description="Path to the XPCC source file"))
    module.add_option(
        StringOption(name="container", default="",
                     description="Name of the XPCC container to generate for"))
    module.add_option(
        StringOption(name="namespace", default="robot",
                     description="Namespace of the generated XPCC communications"))
    return True

def build(env):
    # The xpcc/SConscript of the xpcc:communication module runs the generator
    # and compiles the generated sources into xpcc/generated
    env.outbasepath = "xpcc/tools"
    env.copy("xpcc_generator")
    env.outbasepath = "xpcc/scons/site_tools"
    env.copy("xpcc_generator.py")

    rel = lambda path: env.relative_outpath(path, "xpcc")
    generator = {
        "source": rel(env["source"]),
        "container": env["container"],
        "namespace": env["namespace"],
        "project": rel(env.cwdpath(".")),
    }
    env.collect(":communication:generator", lambda: generator)
