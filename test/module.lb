def init(module):
    module.name = ":test"
    module.description = "Tests for XPCC"

def prepare(module, options):
    module.depends(
        "xpcc:communication",
        # modm's unit test runner and mocks
        "modm-test:test",
        "modm-test:mock:clock",
        "modm-test:mock:can_driver")
    return True

def build(env):
    env.outbasepath = "xpcc-test/src/xpcc-test"
    env.copy("xpcc")
